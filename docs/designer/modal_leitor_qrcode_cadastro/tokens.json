{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Alvenius Design Tokens - Modal Leitor de QRCode e Tela de Cadastro",
  "version": "1.0.0",
  "meta": {
    "app": "Alvenius Spool Management - Rastreio de Produtos",
    "referenceCadastroVazio": "copilot-image-c65f64.png",
    "referenceModalQrCode": "copilot-image-157449.png",
    "description": "Especificação técnica e visual de tokens para o estado inicial vazio da Tela de Cadastro e para o componente Modal Leitor de QRCode industrial com mira fluorescente e cards informativos."
  },
  "zIndexHierarchy": {
    "modalBackdrop": 1000,
    "modalDialog": 1001,
    "scannerCorners": 1005,
    "scannerQrMockup": 1002,
    "headerFloatingPill": 300,
    "header": 100,
    "mainContent": 50
  },
  "cadastroScreen": {
    "container": {
      "maxWidth": "360px",
      "width": "calc(100% - 24px)",
      "margin": "0 auto",
      "paddingHorizontal": "12px"
    },
    "header": {
      "height": "54px",
      "logo": "alvenius-3-rings",
      "title": "RASTREIO DE PRODUTOS",
      "version": "v2.1.0",
      "borderBottom": "2px solid #8ea8cc",
      "hamburgerColor": "#757c96"
    },
    "floatingPill": {
      "text": "Cadastro",
      "width": "220px",
      "height": "48px",
      "backgroundColor": "#ffffff",
      "borderRadius": "8px",
      "textColor": "#000000",
      "fontWeight": "700",
      "fontSize": "16px",
      "boxShadow": "0 4px 14px rgba(0, 0, 0, 0.12)",
      "zIndex": 300,
      "position": "cavalier-over-header-border",
      "centering": "display: flex; align-items: center; justify-content: center; height: 100%;"
    },
    "cardSpool": {
      "backgroundColor": "#ffffff",
      "border": "1px solid #7188a4",
      "borderRadius": "0px",
      "boxShadow": "0 4px 14px rgba(0, 0, 0, 0.08)",
      "paddingTop": "38px",
      "paddingHorizontal": "12px",
      "paddingBottom": "14px",
      "respiroLivrePillBanner": "14px"
    },
    "bannerSuperior": {
      "backgroundColor": "#e5e7eb",
      "borderRadius": "0px",
      "marginHorizontal": "0px",
      "isContainedWithinCardPadding": true,
      "lateralBreathingMargin": "12px",
      "title": {
        "text": "SPOOL",
        "fontSize": "14px",
        "fontWeight": "700",
        "color": "#111827",
        "textAlign": "center"
      },
      "infoRow": {
        "icon": "info",
        "iconColor": "#111827",
        "text": "Realiza o cadastro de Spool e componentes iniciar processo produção.",
        "fontSize": "11.5px",
        "fontWeight": "500",
        "color": "#111827"
      },
      "bottomGradientDivider": {
        "height": "2.5px",
        "background": "linear-gradient(90deg, #1d4ed8 0%, #3b82f6 50%, #60a5fa 100%)"
      }
    },
    "inputs": {
      "label": {
        "fontSize": "13px",
        "fontWeight": "700",
        "color": "#111827"
      },
      "field": {
        "height": "36px",
        "backgroundColor": "#ffffff",
        "border": "1px solid #cbd5e1",
        "borderRadius": "0px",
        "fontSize": "13px",
        "color": "#0f172a",
        "paddingHorizontal": "10px"
      },
      "emptyState": {
        "codigoLabel": "Código  :",
        "codigoValue": "",
        "descricaoLabel": "Descrição:",
        "descricaoValue": ""
      }
    },
    "quadroComponentes": {
      "border": "1.5px solid #7188a4",
      "totalHeightEmpty": "98px",
      "marginBottomToButtons": "60px",
      "respiroInferiorBranco": "50px-70px",
      "headerStrip": {
        "text": "COMPONENTES",
        "backgroundColor": "#e5e7eb",
        "borderBottom": "1.5px solid #7188a4",
        "textColor": "#111827",
        "fontSize": "13px",
        "fontWeight": "700",
        "textAlign": "center",
        "height": "28px",
        "padding": "5px 8px"
      },
      "tableColumns": {
        "backgroundColor": "#f8fafc",
        "borderBottom": "1.5px solid #7188a4",
        "columnDivider": "none",
        "hasVerticalDividers": false,
        "textColor": "#334155",
        "fontSize": "11px",
        "fontWeight": "700",
        "height": "24px",
        "itens": { "width": "25%", "textAlign": "center", "borderRight": "none" },
        "descricao": { "width": "50%", "textAlign": "center", "borderRight": "none" },
        "qtd": { "width": "25%", "textAlign": "center", "borderRight": "none" }
      },
      "emptyBody": {
        "height": "46px",
        "minHeight": "46px",
        "maxHeight": "46px",
        "backgroundColor": "#ffffff"
      }
    },
    "actionFooter": {
      "display": "grid",
      "gridTemplateColumns": "1fr 1fr 1fr",
      "gap": "8px",
      "height": "44px",
      "borderTop": "none",
      "marginBottom": "0px",
      "paddingBottom": "0px",
      "btnLerQrCode": {
        "state": "active",
        "backgroundColor": "#1d4ed8",
        "textColor": "#ffffff",
        "icon": "qr-code",
        "iconColor": "#ffffff",
        "fontSize": "12px",
        "fontWeight": "700",
        "borderRadius": "0px",
        "border": "none",
        "cursor": "pointer"
      },
      "btnLimpar": {
        "state": "disabled",
        "backgroundColor": "#e5e7eb",
        "textColor": "#fca5a5",
        "icon": "trash-2",
        "iconColor": "#fca5a5",
        "fontSize": "12px",
        "fontWeight": "700",
        "borderRadius": "0px",
        "border": "none",
        "cursor": "not-allowed"
      },
      "btnGravar": {
        "state": "disabled",
        "backgroundColor": "#e5e7eb",
        "textColor": "#86efac",
        "icon": "save",
        "iconColor": "#86efac",
        "fontSize": "12px",
        "fontWeight": "700",
        "borderRadius": "0px",
        "border": "none",
        "cursor": "not-allowed"
      }
    }
  },
  "modalQrReader": {
    "backdrop": {
      "backgroundColor": "rgba(18, 22, 30, 0.75)",
      "backdropFilter": "blur(4px)",
      "webkitBackdropFilter": "blur(4px)"
    },
    "dialog": {
      "maxWidth": "380px",
      "width": "100%"
    },
    "header": {
      "title": {
        "text": "Leitor de QRCode",
        "fontSize": "20px",
        "fontWeight": "700",
        "color": "#ffffff",
        "textAlign": "center"
      },
      "divider": {
        "height": "1px",
        "backgroundColor": "rgba(255, 255, 255, 0.35)"
      }
    },
    "viewfinder": {
      "container": {
        "width": "260px",
        "height": "260px",
        "margin": "14px auto 16px auto",
        "backgroundColor": "#000000",
        "border": "4px solid #ffffff",
        "borderRadius": "6px",
        "position": "relative",
        "boxShadow": "0 8px 24px rgba(0, 0, 0, 0.6)"
      },
      "corners": {
        "color": "#3b82f6",
        "strokeThickness": "4px",
        "size": "24px",
        "positionOffset": "6px",
        "glow": "0 0 6px #3b82f6"
      },
      "cyanGlowBeam": {
        "height": "28px",
        "background": "linear-gradient(180deg, rgba(56, 189, 248, 0.45) 0%, rgba(56, 189, 248, 0) 100%)"
      },
      "qrMockup": {
        "size": "140px",
        "type": "static-svg",
        "color": "#ffffff",
        "animatedLaser": false
      }
    },
    "cardInstructions": {
      "container": {
        "backgroundColor": "#ffffff",
        "borderRadius": "8px",
        "padding": "14px",
        "boxShadow": "0 4px 14px rgba(0, 0, 0, 0.22)"
      },
      "title": {
        "text": "Ler o QRCode do Spool e Componentes.",
        "fontSize": "14px",
        "fontWeight": "700",
        "color": "#000000"
      },
      "steps": [
        "1 - Ler o QRCode do Spool.",
        "2 - Ler o QRCode dos componentes."
      ],
      "stepItem": {
        "fontSize": "13px",
        "fontWeight": "700",
        "color": "#000000"
      },
      "bottomGradientBar": {
        "height": "3.5px",
        "background": "linear-gradient(90deg, #1d4ed8 0%, #3b82f6 50%, #60a5fa 100%)"
      }
    },
    "cardLastRead": {
      "container": {
        "backgroundColor": "#ffffff",
        "borderRadius": "8px",
        "padding": "14px",
        "boxShadow": "0 4px 14px rgba(0, 0, 0, 0.22)"
      },
      "label": {
        "text": "Último QRCode lido:",
        "fontSize": "14px",
        "fontWeight": "700",
        "color": "#000000"
      },
      "contentInline": {
        "fontSize": "12px",
        "fontWeight": "600",
        "color": "#1e293b",
        "separator": " | ",
        "sampleData": "SPL-2024-001 | Tubo Condução Aço Carbono 4\" Sch 40 | 3 componentes"
      }
    },
    "footer": {
      "btnClose": {
        "height": "48px",
        "borderRadius": "8px",
        "backgroundColor": "#dc2626",
        "hoverBackgroundColor": "#b91c1c",
        "textColor": "#ffffff",
        "fontSize": "15px",
        "fontWeight": "700",
        "icon": "circle-x",
        "border": "none",
        "boxShadow": "0 3px 10px rgba(220, 38, 38, 0.40)",
        "cursor": "pointer"
      }
    }
  }
}
