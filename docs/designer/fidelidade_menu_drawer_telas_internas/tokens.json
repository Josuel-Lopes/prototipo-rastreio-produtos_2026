{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Alvenius Drawer & Header Design Tokens - Fidelidade Telas Internas",
  "version": "2.1.0",
  "meta": {
    "app": "Alvenius Spool Management - Rastreio de Produtos",
    "referenceWorkDrawerActive": "copilot-image-ca7085.png",
    "referenceWorkDrawerGeneral": "copilot-image-dc8611.png",
    "referenceHomeDrawer": "copilot-image-988b75.png",
    "issueReference": "copilot-image-247960.png (Pill cortada ao meio pelo drawer)",
    "description": "Especificação exata de tokens visuais para eliminar corte na Pill de identificação da tela, garantir transparência com blur no drawer, hierarquia de z-index, alinhamento dos itens e botão Sair retangular."
  },
  "zIndexHierarchy": {
    "hamburgerButton": 250,
    "floatingPill": 200,
    "headerMainBar": 160,
    "drawerPanel": 150,
    "drawerContent": 151,
    "baseHeaderContainer": 140,
    "mainContent": 10
  },
  "header": {
    "container": {
      "heightDesktop": "145px",
      "heightMobile": "145px",
      "backgroundColor": "#c0c2c7",
      "borderBottom": "2px solid #8ea8cc"
    },
    "brandSection": {
      "logoHeight": "38px",
      "versionLabel": {
        "text": "v2.0.0",
        "fontSize": "11px",
        "color": "#64748b",
        "fontWeight": "500"
      },
      "workTitle": {
        "text": "RASTREIO DE PRODUTOS",
        "fontSize": "16px",
        "fontWeight": "700",
        "color": "#0a2540",
        "letterSpacing": "0.6px",
        "textTransform": "uppercase"
      }
    },
    "hamburger": {
      "size": "32px",
      "colorDefault": "#757c96",
      "colorActive": "#ef4444",
      "zIndex": 250,
      "cursor": "pointer"
    }
  },
  "floatingPill": {
    "dimensions": {
      "width": "260px",
      "height": "56px",
      "maxWidth": "calc(100vw - 32px)"
    },
    "geometry": {
      "borderRadius": "8px",
      "border": "1px solid #d0d7de"
    },
    "colors": {
      "background": "#ffffff",
      "textColor": "#0a2540"
    },
    "typography": {
      "fontSize": "16px",
      "fontWeight": "700",
      "textAlign": "center",
      "letterSpacing": "0.2px"
    },
    "shadow": {
      "boxShadow": "0 4px 14px rgba(0, 0, 0, 0.18)"
    },
    "positioning": {
      "position": "absolute",
      "top": "145px",
      "left": "50%",
      "transform": "translate(-50%, -50%)",
      "zIndex": 200,
      "pointerEvents": "none",
      "note": "Fica 50% projetada sobre a barra de 145px e 50% sobre o painel do drawer. DEVE possuir z-index 200 para ficar 100% sobreposta e visível, sem ser cortada pelo drawer que fica em z-index 150."
    }
  },
  "drawerPanel": {
    "layout": {
      "position": "fixed",
      "top": "145px",
      "left": "0px",
      "right": "0px",
      "bottom": "0px",
      "width": "100vw",
      "height": "calc(100vh - 145px)",
      "zIndex": 150,
      "overflowY": "auto",
      "scrollBehavior": "smooth"
    },
    "appearance": {
      "background": "rgba(225, 230, 238, 0.94)",
      "backdropFilter": "blur(5px)",
      "webkitBackdropFilter": "blur(5px)",
      "border": "none"
    },
    "contentWrapper": {
      "maxWidth": "580px",
      "margin": "0 auto",
      "paddingTop": "40px",
      "paddingBottom": "32px",
      "paddingHorizontal": "16px",
      "boxSizing": "border-box",
      "notePaddingTop": "O padding-top de 40px garante 12px a 16px de folga limpa abaixo da metade inferior da pill flutuante (que projeta 28px abaixo do top 145px)."
    }
  },
  "drawerUserRow": {
    "dimensions": {
      "height": "auto",
      "paddingBottom": "16px",
      "marginBottom": "0px"
    },
    "divider": {
      "borderBottom": "2px solid #7188a4"
    },
    "typography": {
      "fontSize": "18px",
      "fontWeight": "600",
      "textColor": "#111827",
      "userNameWeight": "700"
    },
    "icon": {
      "name": "user",
      "size": "24px",
      "color": "#111827",
      "strokeWidth": "2"
    }
  },
  "drawerNavList": {
    "item": {
      "height": "52px",
      "minHeight": "52px",
      "paddingVertical": "14px",
      "paddingHorizontal": "0px",
      "borderBottom": "2px solid #7188a4",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between",
      "cursor": "pointer"
    },
    "itemActiveState": {
      "opacity": "0.45",
      "cursor": "default",
      "pointerEvents": "none",
      "note": "Na tela Cadastro (copilot-image-ca7085.png), o item CADASTRO possui opacidade 0.45 suave para indicar estado ativo/selecionado."
    },
    "icon": {
      "size": "22px",
      "color": "#111827",
      "strokeWidth": "2",
      "marginRight": "14px"
    },
    "label": {
      "fontSize": "16px",
      "fontWeight": "600",
      "color": "#111827",
      "textTransform": "uppercase",
      "letterSpacing": "0.3px"
    },
    "chevron": {
      "name": "chevron-right",
      "size": "22px",
      "color": "#6b7280",
      "strokeWidth": "2"
    }
  },
  "drawerLogoutButton": {
    "dimensions": {
      "height": "52px",
      "width": "100%",
      "marginTop": "24px",
      "marginBottom": "24px"
    },
    "geometry": {
      "borderRadius": "0px",
      "border": "2px solid #7188a4"
    },
    "appearance": {
      "backgroundColor": "transparent",
      "hoverBackgroundColor": "rgba(220, 38, 38, 0.06)",
      "activeBackgroundColor": "rgba(220, 38, 38, 0.12)"
    },
    "typography": {
      "fontSize": "17px",
      "fontWeight": "600",
      "color": "#dc2626"
    },
    "icon": {
      "name": "log-out",
      "size": "22px",
      "color": "#dc2626",
      "strokeWidth": "2.2",
      "gap": "10px"
    },
    "alignment": {
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center"
    }
  },
  "drawerHomeVariant": {
    "reference": "copilot-image-988b75.png",
    "structure": [
      "userRow: 'Bem vindo, josuellopes'",
      "divider: '2px solid #7188a4'",
      "logoutButton: 'Retângulo 52px borda #7188a4 cantos 0px com Sair em #dc2626'"
    ],
    "noNavList": true,
    "note": "No modo Home, o menu expandido contém apenas a saudação, um divisor simples e o botão Sair retangular, sem a lista dos 8 módulos."
  }
}
