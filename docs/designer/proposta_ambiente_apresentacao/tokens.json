{
  "name": "Demo Environment Signage Tokens",
  "version": "1.0.0",
  "status": "approved",
  "meta": {
    "officialText": "Ambiente de demonstração",
    "proposalId": "PROP-2026-011",
    "proposalVersion": "1.0",
    "parties": "MAXCODE42 → Alvenius",
    "viewports": {
      "desktop": "1897x989",
      "mobile": "360x740",
      "print": "A4 portrait 210x297mm, margin 12mm 10mm"
    },
    "cssFile": "src/web/styles/demo-environment.css",
    "flag": "DEMO_MODE (src/web/version.js) → body.is-demo"
  },
  "color": {
    "ribbonBg": "#0B2545",
    "ribbonText": "#FFFFFF",
    "accent": "#F5B700",
    "sealText": "#92400E",
    "sealBg": "#FEF3C7",
    "sealBorder": "#F5B700",
    "printFooterText": "#5B6670",
    "printFooterBorder": "#D0D5DD",
    "watermarkText": "#0B2545"
  },
  "contrast": {
    "ribbon": "≈16:1 (AAA)",
    "seal": "≈6.9:1 (AA)",
    "printFooter": "≈5.9:1 (AA)"
  },
  "zIndex": {
    "proposalActionBar": 100,
    "demoRibbon": 140,
    "header": 150,
    "drawer": "250/300",
    "modals": "1000+",
    "printWatermark": 9999
  },
  "ribbon": {
    "className": "demo-ribbon",
    "inject": "index.html (antes de </body>, fora de #app/#modal-root/#toast-root)",
    "position": "fixed; left 0; right 0; bottom 0",
    "pointerEvents": "none",
    "role": "note",
    "ariaLabel": "Ambiente de demonstração. Proposta comercial PROP-2026-011, MAXCODE42 para Alvenius. Dados fictícios.",
    "borderTop": "2px solid #F5B700",
    "dot": { "size": "8px", "radius": "9999px", "color": "#F5B700" },
    "separator": { "char": "·", "opacity": 0.6, "margin": "0 2px" },
    "desktop": {
      "minWidth": "768px",
      "height": "28px",
      "padding": "0 16px",
      "gap": "8px",
      "fontSize": "12px",
      "fontWeight": 500,
      "labelWeight": 700,
      "labelTransform": "uppercase",
      "labelLetterSpacing": "0.08em",
      "letterSpacing": "0.02em",
      "text": "● AMBIENTE DE DEMONSTRAÇÃO · Proposta comercial PROP-2026-011 · MAXCODE42 → Alvenius · Dados fictícios"
    },
    "mobile": {
      "maxWidth": "767px",
      "height": "24px",
      "padding": "0 8px",
      "gap": "6px",
      "fontSize": "11px",
      "text": "● AMBIENTE DE DEMONSTRAÇÃO · PROP-2026-011"
    },
    "bodyReserve": "padding-bottom: calc(var(--demo-ribbon-h) + env(safe-area-inset-bottom, 0px))",
    "overflow": "nowrap; hidden; ellipsis",
    "print": "display: none"
  },
  "seal": {
    "className": "demo-seal",
    "inject": "src/web/components/header.js — após cada .brand-version-sub (2 ocorrências)",
    "text": "DEMO",
    "fontSize": "9px",
    "fontWeight": 700,
    "lineHeight": 1.3,
    "letterSpacing": "0.08em",
    "padding": "1px 5px",
    "marginLeft": "4px",
    "borderRadius": "4px",
    "border": "1px solid #F5B700",
    "title": "Ambiente de demonstração",
    "print": "display: none"
  },
  "print": {
    "scope": "somente rota proposta (src/web/views/proposta-view.js, final de .view-proposta-wrapper)",
    "sheetPaddingBottom": "10mm",
    "footer": {
      "className": "demo-print-footer print-only",
      "text": "Ambiente de demonstração · Proposta comercial PROP-2026-011 · v1.0 · MAXCODE42 → Alvenius",
      "position": "fixed; left 0; right 0; bottom 0 (repete por página)",
      "fontSize": "7.5pt",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "align": "center",
      "paddingTop": "2mm",
      "borderTop": "0.5pt solid #D0D5DD",
      "ariaHidden": true
    },
    "watermarkDiagonal": {
      "enabled": true,
      "className": "demo-print-watermark print-only",
      "lines": ["AMBIENTE DE", "DEMONSTRAÇÃO"],
      "fontSize": "64pt",
      "fontWeight": 800,
      "lineHeight": 1.1,
      "letterSpacing": "0.06em",
      "textTransform": "uppercase",
      "color": "#0B2545",
      "opacity": 0.07,
      "opacityRange": [0.06, 0.08],
      "rotation": "-45deg",
      "position": "fixed; top 50%; left 50%",
      "transform": "translate(-50%, -50%) rotate(-45deg)",
      "transformOrigin": "center center",
      "layout": "flex column, align-items center, white-space nowrap, width max-content",
      "repeat": "1 instância por página A4 (position: fixed em print)",
      "zIndex": 9999,
      "pointerEvents": "none",
      "userSelect": "none",
      "ariaHidden": true,
      "printColorAdjust": "não necessário (texto)"
    },
    "hidden": [".demo-ribbon", ".demo-seal", ".proposal-action-bar", "#app-header", ".proposal-scope-notice", "#modal-root", "#toast-root"]
  },
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
}
