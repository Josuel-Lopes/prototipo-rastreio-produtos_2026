{
  "name": "Alvenius Spool Management Design Tokens",
  "version": "1.3.1",
  "color": {
    "brand": {
      "primary": "#0070ba",
      "primaryDark": "#005696",
      "primaryHover": "#005b99",
      "primaryLight": "#e8f4fc",
      "navy": "#0d3b66",
      "headerBg": "#005696"
    },
    "neutral": {
      "background": "#f0f2f5",
      "surface": "#ffffff",
      "surfaceAlt": "#f8f9fa",
      "headerStrip": "#eaedf1",
      "border": "#d2d8df",
      "borderLight": "#e5e9ee",
      "text": "#212529",
      "textMuted": "#6c757d",
      "textLight": "#ffffff"
    },
    "status": {
      "reservado": {
        "color": "#f1c40f",
        "label": "Reservado (aguardando início)"
      },
      "execucao": {
        "color": "#00bcd4",
        "label": "Execução (em processo produção)"
      },
      "pausado": {
        "color": "#e67e22",
        "label": "Pausado (aguardando para continuar)"
      },
      "continua": {
        "color": "#95a5a6",
        "label": "Continua (retornar para execução)"
      },
      "finalizado": {
        "color": "#27ae60",
        "label": "Finalizado (aguardando \"Aprova CQ\")"
      },
      "reversivel": {
        "color": "#8bc34a",
        "label": "Reversível (retorna início processo.)"
      },
      "sucata": {
        "color": "#e74c3c",
        "label": "Sucata (descarte do produto)"
      },
      "romaneio": {
        "color": "#0070ba",
        "label": "Romaneio (aguardando próxima etapa)"
      }
    },
    "feedback": {
      "infoBg": "#d1ecf1",
      "infoText": "#0c5460",
      "infoBorder": "#bee5eb",
      "warningBg": "#fff3cd",
      "warningText": "#856404"
    },
    "action": {
      "primary": "#0070ba",
      "save": "#198754",
      "clear": "#6c757d",
      "danger": "#dc3545"
    },
    "scanner": {
      "viewfinderBg": "#0a0a0a",
      "cornerBorder": "#00bcd4",
      "scanLine": "#00d2ff",
      "scanGlow": "rgba(0, 210, 255, 0.4)"
    }
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "xxl": "24px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "xxl": "32px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "9999px"
  },
  "boxShadow": {
    "card": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "modal": "0 10px 25px rgba(0, 0, 0, 0.25)",
    "pill": "0 2px 6px rgba(0, 0, 0, 0.1)"
  }
}
